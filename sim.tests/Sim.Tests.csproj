<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The permanent build gate, and the home of the IL scan.

    THE REFERENCE BELOW IS A HintPath TO THE COMMITTED ASSEMBLY, NOT A
    ProjectReference, AND THAT IS THE WHOLE POINT. A project reference was
    proposed and rejected: MSBuild would rebuild sim/ before running these
    tests, so continuous integration would exercise bytes that exist only on
    the runner and never the bytes in the repository. The staleness this
    arrangement exists to catch is exactly the staleness a project reference
    hides. With a HintPath, a source change committed without its rebuild
    fails here on the next push, because the tests are still testing the old
    image.

    A fresh build is not skipped, though: IlScanTests builds sim/ into a
    scratch directory and scans that too, so a float in source plus a
    forgotten rebuild cannot read clean committed bytes and go green.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Sim.Tests</RootNamespace>
    <AssemblyName>Sim.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Sim">
      <HintPath>$(MSBuildThisFileDirectory)../client/Packages/com.ssalter.sim/Runtime/Sim.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    THE RUNNER'S OWN DECLARATIONS, COMPILED HERE AS SOURCES.

    simcli/ContentFiles.cs names the seven files a run is built from: the option
    each is given on a command line, what each is called on disk, and the type
    that parses it. RepoLayout finds the committed content by those names and
    ContentParsers checks each of them, so both would otherwise restate a list
    that has to agree with the runner's. A list that has to agree is the thing
    the declaration exists to remove.

    simcli/SweepColumns.cs names the columns of the balance report in the order
    they are written, and carries the row that is filled in by naming them.
    GoldenSweepTests and CommandLineTests read reports by column, and a test that
    counted its way to one would be another copy of that order. The separator
    refusal lives in the same file, and calling it is the only way to watch it
    work, for the reason SweepColumnsTests gives.

    simcli/BoardMap.cs draws the playfield as text and simcli/RoundFrame.cs
    draws the whole frame a round stands above its prompt: both are pure
    functions to a string, with no console, no state and nothing written down.
    Their layout is the thing about them that can be wrong, so the check is the
    text itself, asserted character for character in BoardMapTests and
    RoundFrameTests. Reaching them through the program would mean playing a run
    and reading the panels back out of its output, which tests the loop around
    the drawing and not the drawing. simcli/TextPanel.cs and simcli/PlainText.cs
    come with them: the one lays a panel beside a block already drawn, the other
    formats every number under the one culture everything this runner writes
    uses and ends every block it writes with the line feed a committed file and
    a canned session both have to agree on.

    simcli/TypedLine.cs reads a line somebody typed at that prompt into the
    word it is, and it is pure on the same terms: a string and a roster in, a
    value or a refusal out, with no run, board or purse anywhere near it. Its
    vocabulary and its refusal sentences are the whole of what it does, so
    TypedLineTests reads them directly rather than through a session that would
    have to be played to reach one.

    simcli/BuildPrompt.cs is the loop those three feed: it composes one round's
    build phase from a reader and prints the frame to a writer. Both are handed
    in, which is the whole of how an interactive verb is exercised from a cold
    shell: BuildPromptTests plays canned transcripts through it with no
    terminal anywhere. It is linked for the same reason the drawings are: what
    is under test is the composing, not a process that would have to be started
    and fed on standard input to reach it.

    simcli/RunPrompt.cs is the lifecycle around that: it commits each composed
    round, prints the round line and stops where the run stops, so
    RunPromptTests plays the committed run's decisions as typed words and holds
    the ten rounds against content/run-outcome.txt. simcli/RunSummary.cs comes
    with it, because the line that says what a run came to is printed both at
    the end of a session and into that committed file, and a line printed twice
    has to have one spelling.

    A source link rather than a project reference, because the runner is
    exercised here as a PROCESS and not as a library: what its verbs are made of
    is argument parsing, file IO and an exit code, none of which exist when
    Program.Main is called from inside a test host. See TheCommandLine. Linking
    a declaration shares the data without making the program a dependency.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../simcli/ContentFiles.cs" Link="ContentFiles.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../simcli/SweepColumns.cs" Link="SweepColumns.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../simcli/BoardMap.cs" Link="BoardMap.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../simcli/RoundFrame.cs" Link="RoundFrame.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../simcli/TypedLine.cs" Link="TypedLine.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../simcli/BuildPrompt.cs" Link="BuildPrompt.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../simcli/RunPrompt.cs" Link="RunPrompt.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../simcli/RunSummary.cs" Link="RunSummary.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../simcli/TextPanel.cs" Link="TextPanel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../simcli/PlainText.cs" Link="PlainText.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
