<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway. This exists only to measure how long Unity takes to notice a
    rebuilt managed plug-in in an embedded package, which is the question
    issue #5 calls "the single highest-value thing for the walking skeleton
    to establish in its first hour: the difference between a 3-second loop
    and a 40-second one."

    It deliberately mirrors the real sim's shape where that shape could
    affect the answer (netstandard2.1, no engine reference, embedded UPM
    package, exactly as issue #15 decided) and deliberately does NOT call
    itself Sim, so it can never be mistaken for the real thing.

    Delete with: probe.ps1 -Remove
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HotReloadProbe</AssemblyName>
    <RootNamespace>HotReloadProbe</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
